{
  "manifest_version": 1,
  "name": "今日运势卡片 (jrys-prpr MaiBot 版)",
  "display_name": "今日运势",
  "version": "1.7.0",
  "description": "仅整句「今日运势」「今日运势详」或白名单「今日桃花」等触发；本地人品定总签，jrys_fortune 解签；可选底栏今日人品 1～99；句末可加 -s 先发文字。",
  "entry": "plugin.py",
  "author": {
    "name": "MaiM",
    "url": "https://www.npmjs.com/package/koishi-plugin-jrys-prpr"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "0.11.0"
  },
  "homepage_url": "https://www.npmjs.com/package/koishi-plugin-jrys-prpr",
  "repository_url": "",
  "keywords": ["fortune", "jrys", "运势", "娱乐"],
  "categories": ["Entertainment"],
  "default_locale": "zh-CN",
  "plugin_info": {
    "is_built_in": false,
    "plugin_type": "entertainment",
    "components": [
      {
        "type": "command",
        "name": "jrys_today_keyword",
        "description": "整句今日运势",
        "pattern": "今日运势(整句)"
      },
      {
        "type": "command",
        "name": "jrys_single_luck_keyword",
        "description": "整句今日桃花等分项",
        "pattern": "今日桃花|…"
      }
    ],
    "features": ["Pillow 运势图", "本地人品签", "jrys_fortune 解签"]
  },
  "id": "MaiM.jrys_prpr_maimbot"
}
