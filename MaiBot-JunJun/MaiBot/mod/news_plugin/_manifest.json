{
  "manifest_version": 1,
  "name": "新闻插件",
  "version": "1.0.0",
  "description": "每天60秒读懂世界新闻 + 历史上的今天",
  "author": {
    "name": "JunJun"
  },
  "license": "AGPL-v3.0",
  "host_application": {
    "min_version": "0.11.0",
    "max_version": "1.0.0"
  },
  "keywords": ["新闻", "60秒", "历史上的今天", "资讯"],
  "categories": ["Information"],
  "dependencies": [],
  "python_dependencies": ["aiohttp"],
  "config_file": "config.toml",
  "enabled": true,
  "components": {
    "tools": [
      {
        "name": "get_60s_news",
        "description": "获取每天60秒读懂世界的最新新闻摘要"
      },
      {
        "name": "get_today_in_history",
        "description": "获取历史上的今天发生的重要事件"
      }
    ],
    "commands": [
      {
        "name": "news",
        "pattern": "/news 或 /新闻",
        "description": "查询每天60秒读懂世界新闻"
      },
      {
        "name": "history",
        "pattern": "/history 或 /历史",
        "description": "查询历史上的今天"
      }
    ]
  }
}
